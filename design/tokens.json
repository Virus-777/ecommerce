    "usage": {
      "brand": "Primary actions, active navigation, links, Official Store label.",
      "deal": "Sale prices, discount badges, flash-sale countdowns. Never for errors or primary actions.",
      "success/warning/danger/info": "Status only, always paired with an icon or text label.",
      "chart-1/chart-2": "Two-series charts (company vs marketplace sellers). Validated for colour-vision deficiency in both themes."
    }
  },
  "typography": {
    "family": {
      "display": "Bricolage Grotesque",
      "ui": "Figtree",
      "mono": "IBM Plex Mono"
    },
    "familyUsage": {
      "display": "Store marketing headings only (hero, campaign titles, page titles in the store). Never in back-office tables.",
      "ui": "Everything else.",
      "mono": "Order references, SKUs, tracking numbers, IDs."
    },
    "size": { "2xs": 11, "xs": 12, "sm": 13, "md": 15, "lg": 17, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 38 },
    "lineHeight": { "tight": 1.2, "snug": 1.35, "body": 1.5 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "display-lg": { "family": "display", "size": 38, "weight": 700, "lineHeight": 1.1 },
      "display-md": { "family": "display", "size": 30, "weight": 700, "lineHeight": 1.15 },
      "title-lg": { "family": "ui", "size": 24, "weight": 700, "lineHeight": 1.2 },
      "title-md": { "family": "ui", "size": 20, "weight": 700, "lineHeight": 1.25 },
      "title-sm": { "family": "ui", "size": 17, "weight": 600, "lineHeight": 1.35 },
      "body": { "family": "ui", "size": 15, "weight": 400, "lineHeight": 1.5 },
      "body-sm": { "family": "ui", "size": 13, "weight": 400, "lineHeight": 1.45 },
      "label": { "family": "ui", "size": 13, "weight": 600, "lineHeight": 1.3 },
      "caption": { "family": "ui", "size": 12, "weight": 500, "lineHeight": 1.35 },
      "overline": { "family": "ui", "size": 11, "weight": 700, "lineHeight": 1.3, "letterSpacing": "0.08em", "transform": "uppercase" },
      "code": { "family": "mono", "size": 13, "weight": 500, "lineHeight": 1.4 }
    }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "9": 48, "10": 64 },
  "radius": { "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 999 },
  "elevation": {
    "1": "0 1px 2px rgba(16,32,28,0.06)",
    "2": "0 2px 6px rgba(16,32,28,0.06), 0 8px 24px rgba(16,32,28,0.06)",
    "3": "0 12px 40px rgba(16,32,28,0.18)"
  },
  "breakpoint": {
    "$description": "Mobile-first. Phone < 768 (Android app layout: bottom tab bar), tablet 768-1023, desktop >= 1024, wide >= 1280.",
    "sm": 480, "md": 768, "lg": 1024, "xl": 1280
  },
  "layout": {
    "container": 1240,
    "sidebar": 248,
    "headerHeight": 64,
    "tabBarHeight": 64,
    "minTouchTarget": 44,
    "gutter": { "phone": 16, "tablet": 24, "desktop": 32 }
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "durationFast": 120,
    "duration": 200,
    "reducedMotion": "Disable transitions and countdown animation when the OS asks for reduced motion."
  },
  "icons": {
    "set": "Lucide",
    "web": "lucide-react",
    "android": "Lucide Android vector drawables (same names)",
    "strokeWidth": 1.75,
    "sizes": { "sm": 16, "md": 20, "lg": 24 }
  }
}
