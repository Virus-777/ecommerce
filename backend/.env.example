# Copy to .env (or export) to override. Every value has a working default for local development.
# Checked at startup by src/kernel/config/index.ts; an invalid value stops the server.
# development | test | production
NODE_ENV=development
# Listen address: default 127.0.0.1 outside production (development tokens are refused on any other
# host, and with a MONGODB_URI that isn't local), 0.0.0.0 in production.
# HOST=127.0.0.1
PORT=4000
# Internal load-balancer health check (GET /health); default PORT+1
# HEALTH_PORT=4001
# fatal | error | warn | info | debug | trace | silent (tests always run silent)
LOG_LEVEL=info

# MongoDB (docs/04-mongodb-migration.md): a replica set (transactions need one), MongoDB 6.0 or later; required in
# production. Empty = an embedded replica set (an installed MongoDB is used when there is one, else
# mongodb-memory-server downloads one); MONGO_DATA_DIR keeps its data between restarts.
# MONGODB_URI=mongodb://localhost:27017/marketly?replicaSet=rs0
# MONGO_DATA_DIR=.data/mongo
# Apply the MongoDB schema (collections, validators, indexes) and pending data migrations at startup:
# default on outside production (production runs `npm run migrate`)
MIGRATE_ON_START=true

# Plan ch. 20 launch phase (1-4, default 2): endpoints of a later phase answer 501 NOT_IMPLEMENTED
LAUNCH_PHASE=2
MARKET_TIME_ZONE=America/Los_Angeles
MARKET_CURRENCY=USD
# Delivery location used before the shopper gives one (prices with shipping, delivery estimates)
MARKET_DEFAULT_POSTAL_CODE=97205
MARKET_DEFAULT_LOCATION_LABEL=Portland

# Every request needs a token (docs/03-auth-middleware.md). The public keys that verify tokens;
# required in production. Development and tests also trust the dev key.
# AUTH_JWKS={"keys":[{"kty":"OKP","crv":"Ed25519","x":"...","kid":"..."}]}
AUTH_ISSUER=marketly-identity
# Identity's private signing key (Ed25519 JWK with a kid); its public part is trusted automatically.
# Needed to issue tokens when DEV_TOKENS is off. Development signs with the dev key.
# AUTH_SIGNING_JWK={"kty":"OKP","crv":"Ed25519","x":"...","d":"...","kid":"..."}

# Root secret for links and tokens modules sign (unsubscribe, reply-to, file links, audit checkpoints).
# At least 32 characters. Required in production, and on a non-loopback HOST without DEV_TOKENS;
# while DEV_TOKENS is on, a fixed dev value is used.
# APP_SECRET=
# Webhook signing secrets per provider. The key is the URL's provider or carrier
# (/webhooks/payments/providers/{provider}/..., /webhooks/shipping/carriers/{carrier}/...), else the
# module name (finance, media, notifications, sellers). While DEV_TOKENS is on, every provider
# also accepts "dev-webhook-secret".
# WEBHOOK_SECRETS={"stripe":"...","ups":"...","notifications":"..."}

# Public addresses of the apps, for links in emails (required in production)
STORE_URL=http://localhost:3000
SELLER_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# Public address of this API: links to the files it serves (<API_URL>/files/...) point here.
# Default http://localhost:PORT; required in production.
# API_URL=https://api.marketly.com
# How often each server pulls session revocations from identity (at least 500)
REVOCATION_POLL_MS=3000

# File storage for media (docs/02-backend-architecture.md "File storage configuration").
# local: files on this server's disk under MEDIA_STORAGE_DIR (back it up with the database; a shared
# volume when there is more than one server). memory: lost on restart (the default in tests only;
# refused in production).
MEDIA_STORAGE=local
MEDIA_STORAGE_DIR=.data/media

# Development only: sign and accept tokens from `npm run token` with a per-machine key (created on
# first use in .data/, never committed). Also accepts the app proof "dev", and for dev-key tokens
# the step-up code 000000 and re-auth tokens dev-reauth.<purpose>. On by default outside production;
# refused in production. While it is on, HOST must be loopback and MONGODB_URI local (or empty).
DEV_TOKENS=true
DEV_SIGNING_KEY_FILE=.data/dev-signing-key.json

# Proxies in front of the server: hop count, true, or comma-separated addresses/CIDRs
# TRUST_PROXY=1
# Allowed browser origins per app (comma-separated; default none)
CORS_STORE_ORIGINS=http://localhost:3000
CORS_SELLER_ORIGINS=http://localhost:3001
CORS_ADMIN_ORIGINS=http://localhost:3002
# Swagger UI at /docs, served without a token: default on with NODE_ENV=development only; refused in production
DOCS_ENABLED=true
# Website app proof (Cloudflare Turnstile)
# TURNSTILE_SECRET=
# Off only for contract and load tests; refused in production
RATE_LIMITS=true
# Where rate-limit windows are counted: mongo (kernel.rate_limits, shared by every instance) or memory (per
# process). Default: mongo with MONGODB_URI, else memory.
# RATE_LIMIT_STORE=mongo

# Search engine (docs/02-backend-architecture.md §9): mongo (default; development and tests: stemmed words and
# prefixes over the read model, weaker misspelling tolerance) or opensearch (production). MongoDB stays the read
# model; OpenSearch is fed from it after each commit.
SEARCH_ENGINE=mongo
# One node or a comma-separated list; required with opensearch
# OPENSEARCH_URL=https://search.internal:9200
# Credentials: a username and password (together), or an API key (sent as "Authorization: ApiKey <key>")
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_API_KEY=
# Alias <prefix>-products → versioned index <prefix>-products-<UTC timestamp>
# OPENSEARCH_INDEX_PREFIX=marketly
# OPENSEARCH_SHARDS=1
# OPENSEARCH_REPLICAS=1
# false (near real time, ~1 s) | wait_for | true
# OPENSEARCH_REFRESH=false
# OPENSEARCH_REQUEST_TIMEOUT_MS=10000
# Bulk attempts for rejected/failed items before products are queued for search.process-dirty
# OPENSEARCH_BULK_ATTEMPTS=3
# How long a server trusts what it knows about a running full reindex (a reindex waits this long + 1 s)
# OPENSEARCH_ALIAS_CACHE_MS=5000

# Validate every response against its spec schema: default on outside production
RESPONSE_VALIDATION=true
# Work jobs and keep their schedules in this process (instances without it only enqueue)
JOBS_ENABLED=false
# mongo (queue in MongoDB kernel.jobs; each scheduled run once across instances; needs MONGODB_URI) or
# inprocess (timers in each process). Default: mongo with MONGODB_URI, else inprocess.
# JOBS_BACKEND=mongo
# The deployment (image tag, commit): "on boot" jobs run once per deploy and module set
# DEPLOY_ID=
# Store and seller GraphQL accept persisted query ids only: default on in production
GRAPHQL_PERSISTED_ONLY=false
# Comma-separated module list overriding src/modules.config.ts (tests, partial deployments)
# MODULES=identity,access,audit
