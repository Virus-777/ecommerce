# Copy to .env (or export) to override. Every value has a working default for local development.
NODE_ENV=development
PORT=4000
# Internal load-balancer health check (GET /health); default PORT+1
# HEALTH_PORT=4001
# Internal load-balancer health check (GET /health); default PORT+1
# HEALTH_PORT=4001
LOG_LEVEL=info

# Empty = in-process PGlite in memory. Set PGLITE_DIR to keep data between restarts,
# or DATABASE_URL to use a PostgreSQL server.
# DATABASE_URL=postgres://marketly:marketly@localhost:5432/marketly
# PGLITE_DIR=.data/pglite
MIGRATE_ON_START=true

# Plan ch. 20 launch phase: endpoints of a later phase answer 501 NOT_IMPLEMENTED
LAUNCH_PHASE=2
MARKET_TIME_ZONE=America/Los_Angeles
MARKET_CURRENCY=USD

# Every request needs a token (docs/03-auth-middleware.md). Production: identity's public keys.
# AUTH_JWKS={"keys":[{"kty":"OKP","crv":"Ed25519","x":"...","kid":"..."}]}
AUTH_ISSUER=marketly-identity
# Production: identity's private signing key (Ed25519 JWK with a kid). Development signs with the dev key.
# AUTH_SIGNING_JWK={"kty":"OKP","crv":"Ed25519","x":"...","d":"...","kid":"..."}

# Root secret for links and tokens modules sign (unsubscribe, reply-to, downloads, 2-step secrets).
# Required in production, at least 32 characters; development uses a fixed dev value.
# APP_SECRET=
# Webhook signing secrets per provider (development: "dev-webhook-secret" for every provider)
# WEBHOOK_SECRETS={"payments":"...","shipping":"...","notifications":"..."}

# Public addresses of the apps, for links in emails (required in production)
STORE_URL=http://localhost:3000
SELLER_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# Public address of this API: links to the files it serves (<API_URL>/files/...) point here.
# Default http://localhost:PORT; required in production.
# API_URL=https://api.marketly.com
REVOCATION_POLL_MS=3000

# File storage for media (docs/02-backend-architecture.md "File storage configuration").
# local: files on this server's disk under MEDIA_STORAGE_DIR (back it up with the database; a shared
# volume when there is more than one server). memory: lost on restart (the default in tests only).
MEDIA_STORAGE=local
MEDIA_STORAGE_DIR=.data/media

# Development only: sign and accept tokens from `npm run token` with a per-machine key (created on
# first use in .data/, never committed). Also accepts the app proof "dev", the step-up code 000000
# and re-auth tokens dev-reauth.<purpose>. Refused in production.
DEV_TOKENS=true
DEV_SIGNING_KEY_FILE=.data/dev-signing-key.json

# Proxies in front of the server: hop count, true, or comma-separated addresses
# TRUST_PROXY=1
# Allowed browser origins per app (comma-separated)
CORS_STORE_ORIGINS=http://localhost:3000
CORS_SELLER_ORIGINS=http://localhost:3001
CORS_ADMIN_ORIGINS=http://localhost:3002
# Swagger UI at /docs (on in development)
DOCS_ENABLED=true
# Website app proof (Cloudflare Turnstile)
# TURNSTILE_SECRET=
# Off only for contract and load tests; refused in production
RATE_LIMITS=true
# Where rate-limit windows are counted: postgres (kernel.rate_limits, shared by every instance) or
# memory (per process). Default: postgres with DATABASE_URL, else memory.
# RATE_LIMIT_STORE=postgres

# Search engine (docs/02-backend-architecture.md §9): postgres (default; development and tests) or
# opensearch (production). PostgreSQL stays the read model; OpenSearch is fed from it after each commit.
SEARCH_ENGINE=postgres
# One node or a comma-separated list
# OPENSEARCH_URL=https://search.internal:9200
# Credentials: a username and password, or an API key (sent as "Authorization: ApiKey <key>")
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_API_KEY=
# Alias <prefix>-products → versioned index <prefix>-products-<UTC timestamp>
# OPENSEARCH_INDEX_PREFIX=marketly
# OPENSEARCH_SHARDS=1
# OPENSEARCH_REPLICAS=1
# false (near real time, ~1 s) | wait_for | true
# OPENSEARCH_REFRESH=false
# OPENSEARCH_REQUEST_TIMEOUT_MS=10000
# Bulk attempts for rejected/failed items before products are queued for search.process-dirty
# OPENSEARCH_BULK_ATTEMPTS=3
# How long a server trusts what it knows about a running full reindex (a reindex waits this long + 1 s)
# OPENSEARCH_ALIAS_CACHE_MS=5000

RESPONSE_VALIDATION=true
# Work jobs and keep their schedules in this process (instances without it only enqueue)
JOBS_ENABLED=false
# pgboss (queue in PostgreSQL; each scheduled run once across instances) or inprocess (timers in
# each process). Default: pgboss with DATABASE_URL, else inprocess.
# JOBS_BACKEND=pgboss
# The deployment (image tag, commit): "on boot" jobs run once per deploy and module set
# DEPLOY_ID=
GRAPHQL_PERSISTED_ONLY=false
# MODULES=identity,access,audit
