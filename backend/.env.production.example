# Marketly production settings for ONE offline server on a staff-only local network
# (backend/deploy/linux/README.md). On the server this file becomes /etc/marketly/marketly.env:
# deploy/linux/install.sh creates it from this template the first time and fills in the keys.
# Read by the server at startup (node --env-file=...); src/kernel/config/index.ts checks every value and
# refuses to start on a mistake. After a change: systemctl restart marketly
#
# Values: KEY=value, one per line; no spaces around "="; lines starting with # are comments.

NODE_ENV=production

# ---------------------------------------------------------------- network
# The address staff open in the browser. One name for everything (the Admin Center and the API are the
# same server). It must match the HTTPS certificate (deploy/linux/make-cert.sh <name>) and resolve on staff
# PCs (the LAN's DNS, or a line in each PC's hosts file). Change all seven address lines together
# (these four and the three CORS lines below); https://, no slash at the end.
ADMIN_URL=https://marketly.lan
API_URL=https://marketly.lan
STORE_URL=https://marketly.lan
SELLER_URL=https://marketly.lan
# Browser origins allowed to call the API and refresh the staff session (the same address)
CORS_ADMIN_ORIGINS=https://marketly.lan
CORS_STORE_ORIGINS=https://marketly.lan
CORS_SELLER_ORIGINS=https://marketly.lan

# Listen on every network interface, HTTPS on the standard port (systemd lets the service user bind 443/80)
HOST=0.0.0.0
PORT=443
# Plain http://... only answers "moved to https://..." (301)
HTTP_REDIRECT_PORT=80
# HTTPS certificate and its private key, made on this server by deploy/linux/make-cert.sh
TLS_CERT_FILE=/etc/marketly/tls/server.crt
TLS_KEY_FILE=/etc/marketly/tls/server.key
# Internal health check (GET /health, plain HTTP, this machine only): read by deploy/linux/check.sh
HEALTH_PORT=4001
HEALTH_HOST=127.0.0.1
# No proxy in front: the server terminates HTTPS itself. Set only when a proxy does.
# TRUST_PROXY=1

# The built Admin Center, served on the same address (the release's admin/ folder)
ADMIN_APP_DIR=/opt/marketly/current/admin

# ---------------------------------------------------------------- database
# MongoDB on this machine only (bindIp 127.0.0.1), as the one-member replica set rs0 (transactions need a
# replica set; deploy/linux/install.sh runs db-setup to create it)
MONGODB_URI=mongodb://127.0.0.1:27017/marketly?replicaSet=rs0
# The schema is applied by install.sh (prod:migrate) before the server starts, not at startup
MIGRATE_ON_START=false

# ---------------------------------------------------------------- jobs
# This one process also works the scheduled jobs (search indexing, refunds, payouts, clean-ups ...)
JOBS_ENABLED=true
JOBS_BACKEND=mongo
# The release name: "on boot" jobs run once per release. install.sh writes it for each release.
DEPLOY_ID=not-installed

# ---------------------------------------------------------------- files
# Uploaded files (images, documents) on this server's disk; backed up by deploy/linux/backup.sh
MEDIA_STORAGE=local
MEDIA_STORAGE_DIR=/var/lib/marketly/media

# ---------------------------------------------------------------- keys (written by: npm run prod:keys -- --env <this file>)
# Never share this file; never commit it. install.sh fills these three lines the first time.
# Identity's private Ed25519 key that signs sign-in tokens (JWK with a kid)
# AUTH_SIGNING_JWK=
# The public keys that verify tokens (the signing key's, and after a rotation the previous one)
# AUTH_JWKS=
# Root secret (at least 32 characters) for pass codes, file links and audit checkpoints. Never change it:
# stored pass codes, audit checkpoints and file links depend on it.
# APP_SECRET=
AUTH_ISSUER=marketly-identity

# ---------------------------------------------------------------- safety switches (production refuses other values)
DEV_TOKENS=false
DOCS_ENABLED=false
RATE_LIMITS=true
RATE_LIMIT_STORE=mongo

# An app proves it is a real Marketly app before its first session; the usual checks (Cloudflare, Google) need the
# internet. On this offline server, a browser on the local network (192.168.x, 10.x, 172.16-31.x) needs no proof;
# any other address still does. Turn it off only if the server gets internet access and TURNSTILE_SECRET.
APP_PROOF_LOCAL_NETWORK=true
GRAPHQL_PERSISTED_ONLY=true
RESPONSE_VALIDATION=false

# ---------------------------------------------------------------- market and logs
LOG_LEVEL=info
# Transactions slower than this (ms), or retried after a write conflict, log a warning (docs/MAINTAINING.md §6)
TX_SLOW_MS=200
LAUNCH_PHASE=2
MARKET_TIME_ZONE=America/Los_Angeles
MARKET_CURRENCY=USD
MARKET_DEFAULT_POSTAL_CODE=97205
MARKET_DEFAULT_LOCATION_LABEL=Portland
# Search over MongoDB (no separate search engine on an offline server)
SEARCH_ENGINE=mongo
