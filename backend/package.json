{
  "name": "marketly-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Marketly marketplace backend: Fastify kernel + removable modules, generated from docs/api/spec.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "tsx tools/generate.ts",
    "gen:check": "tsx tools/generate.ts --check",
    "migrate": "tsx tools/migrate.ts",
    "modules": "tsx tools/modules.ts",
    "module:new": "tsx tools/new-module.ts",
    "check:api": "tsx tools/check-api.ts",
    "check:boundaries": "tsx tools/check-boundaries.ts",
    "check": "npm run gen:check && npm run typecheck && npm run check:boundaries && npm run check:api && npm test",
    "token": "tsx --env-file-if-exists=.env tools/token.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "graphql": "^16.11.0",
    "kysely": "^0.29.6",
    "mercurius": "^16.10.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
