  "events": { "publishes": [], "consumes": [] },
  "permissions": [
    { "key": "departments.view", "audience": "staff", "desc": "See the department pages' content in Admin › Departments" },
    { "key": "departments.phones.manage", "audience": "staff", "desc": "Pick the phones of the Phone tab" },
    { "key": "departments.blogs.manage", "audience": "staff", "desc": "Blog topics, authors and posts; hide replies and decide reports" },
    { "key": "departments.companies.manage", "audience": "staff", "desc": "Industries and company pages; handle inquiries" },
    { "key": "departments.play.manage", "audience": "staff", "desc": "Play center games and ranking tables" }
  ],
  "settings": [
    { "key": "blogRepliesOpen", "type": "bool", "default": true, "desc": "Customers can reply to blog posts" }
  ],
  "integrations": [],
  "errorCodes": {
    "SLUG_TAKEN": { "status": 409, "meaning": "Another record already uses this slug." },
    "IN_USE": { "status": 409, "meaning": "Posts or companies still use it; move or delete them first." },
    "ALREADY_REPORTED": { "status": 409, "meaning": "You already reported this." },
    "REPLIES_CLOSED": { "status": 409, "meaning": "Replies are closed for now." }
  },
  "notes": [
    "Department pages exist only in the app for now (2026-10-21 decision): the web store has no pages for these endpoints yet.",
    "Blog posts are written by staff under author profiles; customers react, reply and report (2026-10-21 decision). Replies are shown at once and hidden by staff when needed.",
    "Play center is list-only at this phase (2026-10-21 decision): games and the ranking tables staff keep. Game.playable is false; score submission comes with playing.",
    "Bodies are sanitized HTML with the same allow-list as content's news and help (a copy of content domain rules sanitizeHtml, since modules don't import each other's files). Pictures are content_image uploads attached with media.attach to the record that shows them.",
    "Slugs are made from the name or title when omitted (lowercase words joined by -) and must be unique per table; a taken slug answers SLUG_TAKEN.",
    "A reply's authorName is the customer's first name and last initial when it was written (customers.getProfile), else Customer."
  ]
}
