{
  "name": "purchasing",
  "title": "Purchasing",
  "group": "Catalog and stock",
  "phase": 1,
  "chapters": [9, 2],
  "summary": "Buying stock for the Official Store: suppliers and their price lists, purchase orders (Draft, Sent, Partly received, Received, Cancelled) with buying costs and expected deliveries, receiving records (expected vs received, shortages, damage) that feed inventory, and supplier claims.",
  "owns": [
    "Suppliers: contacts, payment terms, lead time, on-time and accuracy performance",
    "Supplier price lists (supplier SKU, unit cost, minimum order, lead time)",
    "Purchase orders (PUR-YYMM-NNNN) with lines, buying costs, freight and approval above the buyer's limit",
    "Expected deliveries: carrier, reference, arrival window, delays and reschedules",
    "Receiving records (REC-YYMMDD-NN): expected vs received, shortages, damaged units with photos, put-away bin",
    "Supplier claims for shortages and damage",
    "Reorder suggestions from low stock and incoming quantities"
  ],
  "notOwns": [
    "Stock quantities and making received units sellable: inventory (Inventory Manager confirms)",
    "Bins and put-away tasks: warehouse",
    "Paying supplier invoices and company cost accounting: finance",
    "Seller stock: sellers buy their own stock outside the platform"
  ],
  "dependsOn": ["inventory"],
  "optionalDeps": ["access", "audit", "media", "notifications", "finance", "warehouse", "reports"],
  "publicApi": [
    { "name": "getPreferredSupplier", "signature": "(stockItemId: uuid) => { supplierId: uuid, name: string, supplierSku: string|null, unitCost: Money, returnAuthorizationRequired: bool } | null", "desc": "Used when a return outcome is 'return to supplier'", "usedBy": ["returns", "inventory"] },
    { "name": "getOpenPurchaseOrders", "signature": "(stockItemId: uuid) => { purchaseOrderId: uuid, ref: string, quantityOpen: int, expectedDate: date|null }[]", "desc": "Incoming detail for stock screens and restock estimates", "usedBy": ["inventory", "offers"] },
    { "name": "exportRows", "signature": "(dataset: string, filters: json, principal: identity.Principal, cursor?: string) => { rows: json[], nextCursor?: string }", "desc": "Export rows for reports dataset purchasing.admin.receiving (receiving records)", "usedBy": ["reports"] }
  ],
