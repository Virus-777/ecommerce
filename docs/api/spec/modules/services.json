    "ReviewAdmin": { "id": "uuid", "serviceId": "uuid", "serviceTitle": "string", "requestId": "uuid", "rating": "int", "text": "string?", "authorName": "string", "status": "enum(visible|hidden)", "createdAt": "datetime" }
  },
  "tables": [
    { "name": "categories", "columns": { "id": "uuid pk", "area": "text", "slug": "text", "name": "text", "icon": "text?", "position": "int", "visible": "bool" }, "indexes": ["unique (area, slug)", "(area, position)"] },
    { "name": "providers", "columns": { "id": "uuid pk", "slug": "text unique", "name": "text", "logo": "jsonb?", "cover": "jsonb?", "kind": "text?", "category_id": "uuid? → categories", "city": "text?", "verified": "bool", "photos": "jsonb", "description": "text?", "since": "int?", "contacts": "jsonb", "location": "jsonb?", "hours": "jsonb", "staff": "jsonb", "reply_time": "text?", "status": "text", "rating_sum": "int", "rating_count": "int", "rating_stars": "jsonb", "created_at": "timestamptz", "updated_at": "timestamptz" }, "indexes": ["(status, name)", "(category_id, status)"] },
    { "name": "services", "columns": { "id": "uuid pk", "slug": "text unique", "area": "text", "provider_id": "uuid → providers", "category_id": "uuid? → categories", "title": "text", "summary": "text?", "image": "jsonb?", "photos": "jsonb", "badge": "text?", "from_price": "bigint?", "currency": "text", "price_unit": "text", "duration_label": "text?", "supported_label": "text?", "coverage": "text?", "tags": "jsonb", "description": "text?", "included": "jsonb", "requirements": "jsonb", "supported": "jsonb", "os_versions": "jsonb", "handover": "jsonb", "price_table": "jsonb", "price_table_title": "text?", "terms": "jsonb", "steps": "jsonb", "slot_minutes": "int?", "duration_minutes": "int?", "status": "text", "position": "int", "rating_sum": "int", "rating_count": "int", "rating_stars": "jsonb", "created_at": "timestamptz", "updated_at": "timestamptz" }, "indexes": ["(area, status, position)", "(provider_id, status, position)", "(category_id, status, position)"] },
    { "name": "requests", "columns": { "id": "uuid pk", "ref": "text unique", "area": "text", "service_id": "uuid → services", "provider_id": "uuid → providers", "customer_id": "uuid", "slot_start": "timestamptz?", "slot_end": "timestamptz?", "staff_id": "text?", "contact": "jsonb", "details": "jsonb", "status": "text", "provider_note": "text?", "staff_note": "text?", "history": "jsonb", "reviewed": "bool", "created_at": "timestamptz", "updated_at": "timestamptz" }, "indexes": ["(customer_id, created_at)", "(area, status, created_at)", "(provider_id, slot_start)", "(service_id, slot_start)"] },
    { "name": "reviews", "columns": { "id": "uuid pk", "service_id": "uuid → services", "provider_id": "uuid → providers", "request_id": "uuid unique → requests", "customer_id": "uuid", "author_name": "text", "rating": "int", "text": "text?", "status": "text", "created_at": "timestamptz" }, "indexes": ["(service_id, status, created_at)"] }
  ],
  "stateMachines": [
    {
      "name": "Service request", "field": "ServiceRequest.status", "initial": "requested",
      "transitions": [
        ["requested", "confirm", "confirmed"], ["requested", "decline", "declined"], ["requested", "cancel", "cancelled"],
        ["confirmed", "start", "in_progress"], ["confirmed", "complete", "completed"], ["confirmed", "cancel", "cancelled"], ["confirmed", "decline", "declined"],
        ["in_progress", "complete", "completed"], ["in_progress", "cancel", "cancelled"]
      ],
      "notes": "Customers cancel while requested or confirmed (a booking up to 2 hours before its slot). Staff confirm, start, complete, decline or cancel on the provider's behalf. A cancelled or declined booking frees its slot."
    }
  ],
  "endpoints": [
    { "id": "listCategories", "area": "store", "method": "GET", "path": "/categories", "summary": "Visible categories of an area in order", "auth": "visitor", "query": { "area": "enum(os_install|post_sale|welfare|booking)" }, "response": "ServiceCategory[]", "screens": ["store/phones", "store/welfare", "store/booking"] },
    { "id": "listServices", "area": "store", "method": "GET", "path": "/services", "summary": "Published services of an area", "auth": "visitor", "paging": true, "query": { "area": "enum(os_install|post_sale|welfare|booking)", "category": { "type": "string?", "desc": "Category slug" }, "q": "string?", "sort": "enum(recommended|price|rating)?" }, "response": "ServiceCard", "screens": ["store/phones", "store/welfare"] },
    { "id": "getService", "area": "store", "method": "GET", "path": "/services/{slug}", "summary": "A service with its provider, price table, terms, steps and newest reviews", "auth": "visitor", "params": { "slug": "string" }, "response": "Service", "errors": ["NOT_FOUND"], "screens": ["store/service", "store/welfare-service"] },
    { "id": "listServiceReviews", "area": "store", "method": "GET", "path": "/services/{id}/reviews", "summary": "A service's reviews, newest first", "auth": "visitor", "params": { "id": "uuid" }, "paging": true, "response": "ServiceReview", "screens": ["store/service"] },
    { "id": "listProviders", "area": "store", "method": "GET", "path": "/providers", "summary": "Published providers of an area (Booking: Available near you)", "auth": "visitor", "paging": true, "query": { "area": "enum(os_install|post_sale|welfare|booking)", "category": "string?", "q": "string?" }, "response": "ProviderCard", "screens": ["store/booking"] },
    { "id": "getProvider", "area": "store", "method": "GET", "path": "/providers/{slug}", "summary": "A provider's page with its services, hours and staff", "auth": "visitor", "params": { "slug": "string" }, "query": { "area": "enum(os_install|post_sale|welfare|booking)?" }, "response": "Provider", "errors": ["NOT_FOUND"], "screens": ["store/booking-provider"] },
    { "id": "getAvailability", "area": "store", "method": "GET", "path": "/services/{id}/availability", "summary": "Free time slots of a bookable service, day by day", "auth": "visitor", "params": { "id": "uuid" }, "query": { "from": { "type": "date?", "desc": "Default today (market time)" }, "days": { "type": "int?", "desc": "1–14, default 7" }, "staffId": "string?" }, "response": "AvailabilityDay[]", "errors": ["NOT_FOUND"], "screens": ["store/booking-provider"] },
    { "id": "createRequest", "area": "store", "method": "POST", "path": "/requests", "summary": "Request or book a service", "desc": "A bookable service needs slotStart, which must still be free (SLOT_TAKEN otherwise).", "auth": "customer", "body": "RequestInput", "response": "ServiceRequest", "status": 201, "idempotent": true, "errors": ["NOT_FOUND", "SLOT_TAKEN", "SLOT_REQUIRED"], "screens": ["store/service", "store/welfare-service", "store/booking-provider"] },
    { "id": "listMyRequests", "area": "store", "method": "GET", "path": "/requests", "summary": "My requests and bookings, newest first", "auth": "customer", "paging": true, "query": { "area": "enum(os_install|post_sale|welfare|booking)?", "state": { "type": "enum(open|past)?", "desc": "open: requested, confirmed, in progress; past: the rest" } }, "response": "ServiceRequest", "screens": ["store/my-requests", "store/booking"] },
    { "id": "getMyRequest", "area": "store", "method": "GET", "path": "/requests/{id}", "summary": "One of my requests", "auth": "customer", "params": { "id": "uuid" }, "response": "ServiceRequest", "errors": ["NOT_FOUND"], "screens": ["store/my-request"] },
    { "id": "cancelMyRequest", "area": "store", "method": "POST", "path": "/requests/{id}/cancel", "summary": "Cancel my request or booking", "auth": "customer", "params": { "id": "uuid" }, "body": { "reason": "string?" }, "response": "ServiceRequest", "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "TOO_LATE_TO_CANCEL"], "screens": ["store/my-request"] },
    { "id": "reviewMyRequest", "area": "store", "method": "POST", "path": "/requests/{id}/review", "summary": "Rate a completed request", "auth": "customer", "params": { "id": "uuid" }, "body": "ReviewInput", "response": "ServiceRequest", "status": 201, "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "ALREADY_REVIEWED"], "screens": ["store/my-request"] },

    { "id": "listCategoriesAdmin", "area": "admin", "method": "GET", "path": "/categories", "summary": "Categories of an area", "auth": "staff", "permission": "services.view", "query": { "area": "enum(os_install|post_sale|welfare|booking)?" }, "response": "ServiceCategory[]", "screens": ["admin/departments-services"] },
    { "id": "createCategory", "area": "admin", "method": "POST", "path": "/categories", "summary": "Add a category", "auth": "staff", "permission": "services.manage", "body": "ServiceCategoryInput", "response": "ServiceCategory", "status": 201, "errors": ["SLUG_TAKEN"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "updateCategory", "area": "admin", "method": "PATCH", "path": "/categories/{id}", "summary": "Rename, reorder, hide or show a category", "auth": "staff", "permission": "services.manage", "params": { "id": "uuid" }, "body": "ServiceCategoryInput", "response": "ServiceCategory", "errors": ["NOT_FOUND", "SLUG_TAKEN"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "deleteCategory", "area": "admin", "method": "DELETE", "path": "/categories/{id}", "summary": "Delete a category no service uses", "auth": "staff", "permission": "services.manage", "params": { "id": "uuid" }, "response": null, "status": 204, "errors": ["NOT_FOUND", "IN_USE"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "listProvidersAdmin", "area": "admin", "method": "GET", "path": "/providers", "summary": "Providers", "auth": "staff", "permission": "services.view", "paging": true, "query": { "area": "enum(os_install|post_sale|welfare|booking)?", "status": "enum(published|hidden)?", "q": "string?" }, "response": "ProviderAdmin", "screens": ["admin/departments-services"] },
    { "id": "createProvider", "area": "admin", "method": "POST", "path": "/providers", "summary": "Add a provider", "auth": "staff", "permission": "services.manage", "body": "ProviderInput", "response": "ProviderAdmin", "status": 201, "errors": ["SLUG_TAKEN"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "getProviderAdmin", "area": "admin", "method": "GET", "path": "/providers/{id}", "summary": "A provider for editing", "auth": "staff", "permission": "services.view", "params": { "id": "uuid" }, "response": "ProviderAdmin", "errors": ["NOT_FOUND"], "screens": ["admin/departments-services"] },
    { "id": "updateProvider", "area": "admin", "method": "PATCH", "path": "/providers/{id}", "summary": "Edit, hide or show a provider", "auth": "staff", "permission": "services.manage", "params": { "id": "uuid" }, "body": "ProviderInput", "response": "ProviderAdmin", "errors": ["NOT_FOUND", "SLUG_TAKEN"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "deleteProvider", "area": "admin", "method": "DELETE", "path": "/providers/{id}", "summary": "Delete a provider without services", "auth": "staff", "permission": "services.manage", "params": { "id": "uuid" }, "response": null, "status": 204, "errors": ["NOT_FOUND", "IN_USE"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "listServicesAdmin", "area": "admin", "method": "GET", "path": "/services", "summary": "Services in staff order", "auth": "staff", "permission": "services.view", "paging": true, "query": { "area": "enum(os_install|post_sale|welfare|booking)?", "providerId": "uuid?", "categoryId": "uuid?", "status": "enum(published|hidden)?", "q": "string?" }, "response": "ServiceAdmin", "screens": ["admin/departments-services"] },
    { "id": "createService", "area": "admin", "method": "POST", "path": "/services", "summary": "Add a service", "auth": "staff", "permission": "services.manage", "body": "ServiceInput", "response": "ServiceAdmin", "status": 201, "errors": ["SLUG_TAKEN"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "getServiceAdmin", "area": "admin", "method": "GET", "path": "/services/{id}", "summary": "A service for editing", "auth": "staff", "permission": "services.view", "params": { "id": "uuid" }, "response": "ServiceAdmin", "errors": ["NOT_FOUND"], "screens": ["admin/departments-services"] },
    { "id": "updateService", "area": "admin", "method": "PATCH", "path": "/services/{id}", "summary": "Edit, hide or show a service", "auth": "staff", "permission": "services.manage", "params": { "id": "uuid" }, "body": "ServiceInput", "response": "ServiceAdmin", "errors": ["NOT_FOUND", "SLUG_TAKEN"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "deleteService", "area": "admin", "method": "DELETE", "path": "/services/{id}", "summary": "Delete a service without open requests", "auth": "staff", "permission": "services.manage", "params": { "id": "uuid" }, "response": null, "status": 204, "errors": ["NOT_FOUND", "IN_USE"], "audited": true, "screens": ["admin/departments-services"] },
    { "id": "listRequestsAdmin", "area": "admin", "method": "GET", "path": "/requests", "summary": "Requests and bookings, newest first", "auth": "staff", "permission": "services.view", "paging": true, "query": { "area": "enum(os_install|post_sale|welfare|booking)?", "status": "enum(requested|confirmed|in_progress|completed|cancelled|declined)?", "providerId": "uuid?", "q": { "type": "string?", "desc": "Ref, customer name or phone" } }, "response": "RequestAdmin", "screens": ["admin/departments-services"] },
    { "id": "getRequestAdmin", "area": "admin", "method": "GET", "path": "/requests/{id}", "summary": "A request", "auth": "staff", "permission": "services.view", "params": { "id": "uuid" }, "response": "RequestAdmin", "errors": ["NOT_FOUND"], "screens": ["admin/departments-services"] },
    { "id": "updateRequest", "area": "admin", "method": "PATCH", "path": "/requests/{id}", "summary": "Confirm, start, complete, decline or cancel a request; move a booking; add notes", "auth": "staff", "permission": "services.requests.manage", "params": { "id": "uuid" }, "body": "RequestUpdate", "response": "RequestAdmin", "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "SLOT_TAKEN"], "audited": true, "events": ["services.request.status_changed"], "screens": ["admin/departments-services"] },
    { "id": "listReviewsAdmin", "area": "admin", "method": "GET", "path": "/reviews", "summary": "Reviews, newest first", "auth": "staff", "permission": "services.view", "paging": true, "query": { "status": "enum(visible|hidden)?", "serviceId": "uuid?" }, "response": "ReviewAdmin", "screens": ["admin/departments-services"] },
    { "id": "moderateReview", "area": "admin", "method": "PATCH", "path": "/reviews/{id}", "summary": "Hide or show a review", "auth": "staff", "permission": "services.manage", "params": { "id": "uuid" }, "body": { "status": "enum(visible|hidden)" }, "response": "ReviewAdmin", "errors": ["NOT_FOUND"], "audited": true, "screens": ["admin/departments-services"] }
  ],
  "events": {
    "publishes": [
      { "name": "services.request.status_changed", "when": "Staff or the customer change a request's status", "payload": { "requestId": "uuid", "customerId": "uuid", "status": "string", "ref": "string" } }
    ],
    "consumes": []
  },
  "permissions": [
    { "key": "services.view", "audience": "staff", "desc": "See providers, services, requests and reviews in Admin › Departments" },
    { "key": "services.manage", "audience": "staff", "desc": "Providers, categories, services; hide reviews" },
    { "key": "services.requests.manage", "audience": "staff", "desc": "Confirm, complete, decline and move requests and bookings" }
  ],
  "settings": [
    { "key": "cancelCutoffMinutes", "type": "int", "default": 120, "desc": "Customers cancel a booking up to this long before its slot", "min": 0 }
  ],
  "integrations": [],
  "errorCodes": {
    "SLUG_TAKEN": { "status": 409, "meaning": "Another record already uses this slug." },
    "IN_USE": { "status": 409, "meaning": "Services or requests still use it." },
    "SLOT_TAKEN": { "status": 409, "meaning": "That time was just booked; pick another." },
    "SLOT_REQUIRED": { "status": 400, "meaning": "Pick a time for this service." },
    "TOO_LATE_TO_CANCEL": { "status": 409, "meaning": "It is too close to the booking to cancel in the app; call the provider." },
    "ALREADY_REVIEWED": { "status": 409, "meaning": "You already rated this." }
  },
  "notes": [
    "Areas: os_install and post_sale are the Phones department's OS install and Post-sale services tabs; welfare is Welfare services; booking is Booking. A provider can serve several areas.",
    "No online payment at this phase (2026-10-22): prices are shown, and customers pay the provider. priceLabel says so.",
    "Slots: the provider's opening hours of the day, cut into slotMinutes from opening time; a slot is taken when a requested, confirmed or in-progress booking of the same service (and the same staff member when one is chosen; any free staff member otherwise) overlaps it; past slots are not available.",
    "Ratings come only from reviews of completed requests (one per request). RatingSummary.average is null without reviews.",
    "Request refs are SR- plus five characters from 23456789ABCDEFGHJKLMNPQRSTUVWXYZ.",
    "The customer's name on a review is their first name and last initial (customers.getProfile), else Customer."
  ]
}
