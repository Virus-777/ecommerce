      "address": { "type": "string?", "desc": "Street line, e.g. 118 Bay Rd" }, "city": { "type": "string?", "desc": "e.g. Portland (Portland, OR is read as city and state when region is empty)" }, "region": { "type": "string?", "desc": "State code, e.g. OR" }, "postalCode": "string?", "phone": "string?", "hours": "OpeningDay[]?", "timeZone": "string?",
