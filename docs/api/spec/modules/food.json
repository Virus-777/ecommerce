{
  "name": "food",
  "title": "Food delivery",
  "group": "Growth",
  "phase": 2,
  "chapters": [],
  "summary": "The app's Food delivery department: restaurants staff keep in Admin › Departments › Food delivery, their menus with sizes and extras, a basket that holds one restaurant's food, and food orders paid by card in their own payment flow (payments purchase intents, not cart and checkout). Staff move each order through accepted, preparing, on the way and delivered on the restaurant's behalf; the card is charged on delivery.",
  "owns": [
    "Food categories (Pizza, Burgers, Asian, …)",
    "Restaurants: name, photos, cuisine, address, opening hours, delivery time, delivery fee, free-delivery threshold, minimum order, promotion line, status",
    "Menus: sections and items with photos, description, price, was-price, diet tags, option groups (sizes, extras) and availability",
    "The customer's basket (one restaurant at a time)",
    "Food orders (FD- references) with their status, delivery estimate and payment",
    "Ratings and reviews of delivered orders, shown on restaurants and items",
    "Customers' saved restaurants (the heart on a restaurant, Account › Saved)",
    "Restaurant points (geocoded from the address, or a pin staff set) and the distance labels on restaurant cards"
  ],
  "notOwns": [
    "Card payments: payments purchase intents (authorizePurchase, completeAction, capturePurchase, voidIntent)",
    "Delivery addresses: customers (getAddressForOrder)",
    "Where the customer is and turning addresses into points: customers (customerLocation, geocodeAddress)",
    "Pictures: media (content_image uploads)",
    "Ads above the restaurants: advertising placement food_top",
    "Cart, checkout and orders of the main store: food never goes there (2026-10-22 decision)"
  ],
  "dependsOn": ["media", "payments", "customers"],
  "optionalDeps": ["audit", "notifications"],
  "publicApi": [
    {"name":"linkTargets","signature":"(input: { kind: 'restaurant', q?: string, ids?: string[], slugs?: string[], limit?: int }) => LinkTarget[]","desc":"Link targets for ad destination pickers (search by q, or resolve ids or URL slugs): restaurants (/food/restaurants/{slug}; available when published), each with its store path the app opens, a label, a short meta line, an image and whether it is shown in the store. Unknown ids are left out.","usedBy":["advertising"]},
    { "name": "exportCustomerData", "signature": "(input: { customerId: uuid, accountId: uuid }) => CustomerDataSection[]", "desc": "The customer's food orders (reference, restaurant, items, amounts, address, status, dates), reviews and saved restaurants for the personal data export", "usedBy": ["customers"] }
  ],
  "types": {
