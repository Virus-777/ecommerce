  "tables": [
    { "name": "categories", "columns": { "id": "uuid pk", "slug": "text unique", "name": "text", "icon": "text?", "image_id": "uuid?", "position": "int", "visible": "bool", "created_at": "timestamptz", "updated_at": "timestamptz" }, "indexes": ["(position)"] },
    { "name": "restaurants", "columns": { "id": "uuid pk", "slug": "text unique", "name": "text", "cuisine": "text", "category_ids": "jsonb", "image_id": "uuid?", "logo_id": "uuid?", "photo_ids": "jsonb", "address": "text?", "city": "text?", "region": "text?", "postal_code": "text?", "lat": "numeric(9,6)? (WGS84 latitude)", "lng": "numeric(9,6)? (WGS84 longitude)", "point_source": "text? (geocoded|staff)", "phone": "text?", "hours": "jsonb", "time_zone": "text", "delivery_min": "int", "delivery_max": "int", "delivery_fee": "bigint", "free_delivery_over": "bigint?", "min_order": "bigint?", "currency": "text", "promo_text": "text?", "promo_badge": "text?", "status": "text (draft|published|paused|hidden)", "position": "int", "rating_sum": "int", "rating_count": "int", "rating_stars": "jsonb", "search_text": "text", "created_at": "timestamptz", "updated_at": "timestamptz" }, "indexes": ["(status, position)"] },
    { "name": "sections", "columns": { "id": "uuid pk", "restaurant_id": "uuid → restaurants", "name": "text", "position": "int" }, "indexes": ["(restaurant_id, position)"] },
    { "name": "items", "columns": { "id": "uuid pk", "restaurant_id": "uuid → restaurants", "section_id": "uuid → sections", "name": "text", "description": "text?", "photo_ids": "jsonb", "price": "bigint", "was_price": "bigint?", "currency": "text", "tag": "text?", "diet_tags": "jsonb", "popular": "bool", "recommended": "bool", "option_groups": "jsonb (OptionGroup[])", "available": "bool", "position": "int", "rating_sum": "int", "rating_count": "int", "rating_stars": "jsonb", "search_text": "text", "created_at": "timestamptz", "updated_at": "timestamptz" }, "indexes": ["(restaurant_id, section_id, position)", "(recommended, available)"] },
    { "name": "baskets", "columns": { "id": "uuid pk", "customer_id": "uuid unique", "restaurant_id": "uuid?", "lines": "jsonb (stored lines: id, itemId, quantity, options, note)", "updated_at": "timestamptz" } },
    { "name": "orders", "columns": { "id": "uuid pk", "ref": "text unique", "customer_id": "uuid", "restaurant_id": "uuid → restaurants", "restaurant": "jsonb (name, slug, cuisine, image at order time)", "lines": "jsonb (OrderLine[])", "subtotal": "bigint", "delivery_fee": "bigint", "total": "bigint", "currency": "text", "address": "jsonb (Address)", "courier_note": "text?", "contact_phone": "text?", "status": "text (payment_pending|payment_failed|placed|accepted|preparing|on_the_way|delivered|cancelled|declined)", "history": "jsonb", "restaurant_note": "text?", "staff_note": "text?", "intent_id": "uuid?", "attempts": "int", "method_label": "text?", "eta_from": "timestamptz?", "eta_to": "timestamptz?", "placed_at": "timestamptz?", "accepted_at": "timestamptz?", "delivered_at": "timestamptz?", "reviewed": "bool", "idempotency_key": "text unique", "created_at": "timestamptz", "updated_at": "timestamptz" }, "indexes": ["(customer_id, created_at)", "(status, created_at)", "(restaurant_id, status, created_at)", "(intent_id)"] },
    { "name": "saved_restaurants", "desc": "A customer's saved restaurants (one row per customer and restaurant)", "columns": { "id": "uuid pk", "customer_id": "uuid", "restaurant_id": "uuid → restaurants", "created_at": "timestamptz" }, "indexes": ["(customer_id, restaurant_id) unique", "(customer_id, created_at)", "(restaurant_id)"] },
    { "name": "reviews", "columns": { "id": "uuid pk", "order_id": "uuid unique → orders", "restaurant_id": "uuid → restaurants", "item_ids": "jsonb", "customer_id": "uuid", "name": "text", "stars": "int", "text": "text?", "hidden": "bool", "hidden_reason": "text?", "created_at": "timestamptz" }, "indexes": ["(restaurant_id, hidden, created_at)"] }
  ],
  "stateMachines": [
    {
      "name": "Food order",
      "field": "FoodOrder.status",
      "initial": "payment_pending",
      "transitions": [["payment_pending", "pay", "placed"], ["payment_pending", "fail", "payment_failed"], ["payment_pending", "abandon", "cancelled"], ["payment_failed", "retry", "payment_pending"], ["payment_failed", "abandon", "cancelled"], ["placed", "accept", "accepted"], ["placed", "decline", "declined"], ["placed", "cancel", "cancelled"], ["accepted", "prepare", "preparing"], ["accepted", "send", "on_the_way"], ["accepted", "cancel", "cancelled"], ["preparing", "send", "on_the_way"], ["preparing", "cancel", "cancelled"], ["on_the_way", "deliver", "delivered"], ["on_the_way", "cancel", "cancelled"]],
      "notes": "pay: the card is authorized (payments.authorizePurchase), the basket is emptied and the restaurant is told. Customers cancel only while placed; staff accept, decline, move and cancel on the restaurant's behalf. deliver captures the payment (payments.capturePurchase); decline and cancel void it (payments.voidIntent). Placed orders not accepted within acceptMinutes are declined automatically."
    }
  ],
  "endpoints": [
    { "id": "listCategories", "area": "store", "method": "GET", "path": "/categories", "summary": "Visible food categories in order", "auth": "visitor", "response": "FoodCategory[]", "screens": ["store/food"] },
    { "id": "listRestaurants", "area": "store", "method": "GET", "path": "/restaurants", "summary": "Published restaurants, open ones first", "auth": "visitor", "paging": true, "query": { "category": { "type": "string?", "desc": "Category slug" }, "q": "string?", "sort": { "type": "enum(recommended|rating|delivery_time|fee|nearest)?", "desc": "nearest: closest to the customer's default delivery address first (restaurants without a point last); as recommended for visitors and customers without a location" } }, "scope": "own-customer", "response": "RestaurantCard", "screens": ["store/food", "store/food-restaurants"] },
    { "id": "getRestaurant", "area": "store", "method": "GET", "path": "/restaurants/{slug}", "summary": "A restaurant with its menu", "desc": "Signed-in customers also get saved and the distance from their default delivery address.", "auth": "visitor", "scope": "own-customer", "params": { "slug": "string" }, "response": "Restaurant", "errors": ["NOT_FOUND"], "screens": ["store/food-restaurant"] },
    { "id": "listRestaurantReviews", "area": "store", "method": "GET", "path": "/restaurants/{slug}/reviews", "summary": "A restaurant's reviews, newest first", "desc": "Visible reviews only (staff can hide one). The rating summary on top of the screen comes from GET /restaurants/{slug}/ratings.", "auth": "visitor", "params": { "slug": "string" }, "paging": true, "query": { "stars": { "type": "int?", "desc": "Only reviews with this many stars (1 to 5)" } }, "response": "RestaurantReview", "errors": ["NOT_FOUND"], "screens": ["store/food-reviews"] },
    { "id": "getRestaurantRatings", "area": "store", "method": "GET", "path": "/restaurants/{slug}/ratings", "summary": "A restaurant's rating summary: average, count and count per star", "auth": "visitor", "params": { "slug": "string" }, "response": "RestaurantRatings", "errors": ["NOT_FOUND"], "screens": ["store/food-reviews"] },
    { "id": "listSavedRestaurants", "area": "store", "method": "GET", "path": "/saved-restaurants", "summary": "My saved restaurants, last saved first", "desc": "Restaurants staff hid or deleted are left out (a hidden one comes back when staff publish it again).", "auth": "customer", "paging": true, "response": "RestaurantCard", "screens": ["store/saved"] },
    { "id": "saveRestaurant", "area": "store", "method": "PUT", "path": "/saved-restaurants/{slug}", "summary": "Save a restaurant (the heart)", "desc": "Saving a saved restaurant again changes nothing.", "auth": "customer", "params": { "slug": "string" }, "response": null, "status": 204, "errors": ["NOT_FOUND"], "screens": ["store/food-restaurant", "store/food", "store/food-restaurants", "store/saved"] },
    { "id": "unsaveRestaurant", "area": "store", "method": "DELETE", "path": "/saved-restaurants/{slug}", "summary": "Remove a restaurant from my saved ones", "desc": "Removing one that isn't saved (or no longer exists) changes nothing.", "auth": "customer", "params": { "slug": "string" }, "response": null, "status": 204, "screens": ["store/food-restaurant", "store/food", "store/food-restaurants", "store/saved"] },
    { "id": "listItems", "area": "store", "method": "GET", "path": "/items", "summary": "Menu items across restaurants", "auth": "visitor", "paging": true, "query": { "recommended": { "type": "bool?", "desc": "Recommended foods" }, "category": "string?", "q": "string?" }, "response": "MenuItemCard", "screens": ["store/food", "store/food-items"] },
    { "id": "getItem", "area": "store", "method": "GET", "path": "/items/{id}", "summary": "A menu item with its photos, sizes and extras", "auth": "visitor", "scope": "own-customer", "params": { "id": "uuid" }, "response": "MenuItem", "errors": ["NOT_FOUND"], "screens": ["store/food-item"] },
    { "id": "getBasket", "area": "store", "method": "GET", "path": "/basket", "summary": "My food basket with prices worked out now", "auth": "customer", "response": "Basket", "screens": ["store/food-restaurant", "store/food-basket"] },
    { "id": "addToBasket", "area": "store", "method": "POST", "path": "/basket/lines", "summary": "Add an item with its options", "desc": "The same item with the same options and note adds to the existing line. An item from another restaurant answers OTHER_RESTAURANT (details.restaurantName) unless replace is true.", "auth": "customer", "body": "BasketLineInput", "response": "Basket", "errors": ["NOT_FOUND", "OTHER_RESTAURANT", "OPTIONS_INVALID", "ITEM_UNAVAILABLE", "RESTAURANT_UNAVAILABLE"], "screens": ["store/food-item", "store/food-restaurant"] },
    { "id": "updateBasketLine", "area": "store", "method": "PATCH", "path": "/basket/lines/{lineId}", "summary": "Change a line's quantity or note; 0 removes it", "auth": "customer", "params": { "lineId": "string" }, "body": "BasketLineUpdate", "response": "Basket", "errors": ["NOT_FOUND"], "screens": ["store/food-basket", "store/food-restaurant"] },
    { "id": "clearBasket", "area": "store", "method": "DELETE", "path": "/basket", "summary": "Empty the basket", "auth": "customer", "response": "Basket", "screens": ["store/food-basket"] },
    { "id": "getPaymentOptions", "area": "store", "method": "GET", "path": "/payment-options", "summary": "Saved cards and a new-card session for the basket total", "auth": "customer", "response": "payments.PaymentOptions", "errors": ["BASKET_EMPTY"], "screens": ["store/food-basket"] },
    { "id": "placeOrder", "area": "store", "method": "POST", "path": "/orders", "summary": "Order the basket", "desc": "Checks the restaurant is open and published, the items available and the minimum order, takes the address (customers.getAddressForOrder) and authorizes the card. accepted → placed and the basket is emptied; requires_action → payment.nextAction (finish with complete-action); failed → payment_failed with payment.decline (the basket stays); pending_check → payment_pending until payments says.", "auth": "customer", "body": "PlaceOrderInput", "response": "FoodOrder", "status": 201, "idempotent": true, "errors": ["BASKET_EMPTY", "RESTAURANT_CLOSED", "BELOW_MINIMUM", "ITEM_UNAVAILABLE", "PRICE_CHANGED", "NOT_FOUND"], "events": ["food.order.status_changed"], "screens": ["store/food-basket"] },
    { "id": "listMyOrders", "area": "store", "method": "GET", "path": "/orders", "summary": "My food orders, newest first", "auth": "customer", "paging": true, "query": { "state": { "type": "enum(open|past)?", "desc": "open: payment pending, placed, accepted, preparing, on the way" } }, "response": "FoodOrder", "screens": ["store/food-orders"] },
    { "id": "getOrder", "area": "store", "method": "GET", "path": "/orders/{id}", "summary": "A food order with its status and payment", "auth": "customer", "params": { "id": "uuid" }, "query": { "refresh": { "type": "bool?", "desc": "Ask the provider about a pending payment first" } }, "response": "FoodOrder", "errors": ["NOT_FOUND"], "screens": ["store/food-order"] },
    { "id": "completeOrderAction", "area": "store", "method": "POST", "path": "/orders/{id}/complete-action", "summary": "Finish the bank challenge of a food order", "auth": "customer", "params": { "id": "uuid" }, "body": "CompleteActionInput", "response": "FoodOrder", "idempotent": true, "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION"], "screens": ["store/food-order", "store/food-basket"] },
    { "id": "retryOrderPayment", "area": "store", "method": "POST", "path": "/orders/{id}/retry", "summary": "Pay a failed food order again", "auth": "customer", "params": { "id": "uuid" }, "body": "RetryPaymentInput", "response": "FoodOrder", "idempotent": true, "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "RESTAURANT_CLOSED"], "screens": ["store/food-order"] },
    { "id": "cancelOrder", "area": "store", "method": "POST", "path": "/orders/{id}/cancel", "summary": "Cancel an order the restaurant hasn't accepted", "auth": "customer", "params": { "id": "uuid" }, "body": "CancelInput", "response": "FoodOrder", "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION"], "events": ["food.order.status_changed"], "screens": ["store/food-order"] },
    { "id": "reviewOrder", "area": "store", "method": "POST", "path": "/orders/{id}/review", "summary": "Rate a delivered order", "auth": "customer", "params": { "id": "uuid" }, "body": "ReviewInput", "response": "FoodOrder", "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "ALREADY_REVIEWED"], "screens": ["store/food-order"] },

    { "id": "listCategoriesAdmin", "area": "admin", "method": "GET", "path": "/categories", "summary": "All food categories in order", "auth": "staff", "permission": "food.view", "response": "FoodCategory[]", "screens": ["admin/departments-food"] },
    { "id": "createCategory", "area": "admin", "method": "POST", "path": "/categories", "summary": "Add a food category", "auth": "staff", "permission": "food.manage", "body": "FoodCategoryInput", "response": "FoodCategory", "status": 201, "errors": ["SLUG_TAKEN"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "updateCategory", "area": "admin", "method": "PATCH", "path": "/categories/{id}", "summary": "Change a food category", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "body": "FoodCategoryInput", "response": "FoodCategory", "errors": ["NOT_FOUND", "SLUG_TAKEN"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "deleteCategory", "area": "admin", "method": "DELETE", "path": "/categories/{id}", "summary": "Delete a food category", "desc": "Restaurants lose the category.", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "response": null, "errors": ["NOT_FOUND"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "listRestaurantsAdmin", "area": "admin", "method": "GET", "path": "/restaurants", "summary": "Restaurants with filters", "auth": "staff", "permission": "food.view", "paging": true, "query": { "status": "enum(draft|published|paused|hidden)?", "categoryId": "uuid?", "q": "string?" }, "response": "RestaurantAdmin", "screens": ["admin/departments-food"] },
    { "id": "createRestaurant", "area": "admin", "method": "POST", "path": "/restaurants", "summary": "Add a restaurant", "auth": "staff", "permission": "food.manage", "body": "RestaurantInput", "response": "RestaurantAdmin", "status": 201, "errors": ["SLUG_TAKEN", "VALIDATION_FAILED"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "getRestaurantAdmin", "area": "admin", "method": "GET", "path": "/restaurants/{id}", "summary": "A restaurant for editing", "auth": "staff", "permission": "food.view", "params": { "id": "uuid" }, "response": "RestaurantAdmin", "errors": ["NOT_FOUND"], "screens": ["admin/departments-food"] },
    { "id": "updateRestaurant", "area": "admin", "method": "PATCH", "path": "/restaurants/{id}", "summary": "Change a restaurant, pause or hide it", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "body": "RestaurantInput", "response": "RestaurantAdmin", "errors": ["NOT_FOUND", "SLUG_TAKEN", "VALIDATION_FAILED"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "deleteRestaurant", "area": "admin", "method": "DELETE", "path": "/restaurants/{id}", "summary": "Delete a restaurant with no orders", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "response": null, "errors": ["NOT_FOUND", "IN_USE"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "getMenuAdmin", "area": "admin", "method": "GET", "path": "/restaurants/{id}/menu", "summary": "A restaurant's sections and items", "auth": "staff", "permission": "food.view", "params": { "id": "uuid" }, "response": "MenuSectionAdmin[]", "errors": ["NOT_FOUND"], "screens": ["admin/departments-food"] },
    { "id": "createSection", "area": "admin", "method": "POST", "path": "/restaurants/{id}/sections", "summary": "Add a menu section", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "body": "MenuSectionInput", "response": "MenuSectionAdmin", "status": 201, "errors": ["NOT_FOUND"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "updateSection", "area": "admin", "method": "PATCH", "path": "/sections/{id}", "summary": "Rename or reorder a menu section", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "body": "MenuSectionInput", "response": "MenuSectionAdmin", "errors": ["NOT_FOUND"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "deleteSection", "area": "admin", "method": "DELETE", "path": "/sections/{id}", "summary": "Delete an empty menu section", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "response": null, "errors": ["NOT_FOUND", "IN_USE"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "createItem", "area": "admin", "method": "POST", "path": "/restaurants/{id}/items", "summary": "Add a menu item", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "body": "MenuItemInput", "response": "MenuItemAdmin", "status": 201, "errors": ["NOT_FOUND", "VALIDATION_FAILED"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "updateItem", "area": "admin", "method": "PATCH", "path": "/items/{id}", "summary": "Change a menu item or mark it unavailable", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "body": "MenuItemInput", "response": "MenuItemAdmin", "errors": ["NOT_FOUND", "VALIDATION_FAILED"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "deleteItem", "area": "admin", "method": "DELETE", "path": "/items/{id}", "summary": "Delete a menu item", "desc": "Past orders keep their copy.", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "response": null, "errors": ["NOT_FOUND"], "audited": true, "screens": ["admin/departments-food"] },
    { "id": "listOrdersAdmin", "area": "admin", "method": "GET", "path": "/orders", "summary": "Food orders, newest first", "auth": "staff", "permission": "food.view", "paging": true, "query": { "status": "enum(payment_pending|payment_failed|placed|accepted|preparing|on_the_way|delivered|cancelled|declined)?", "state": "enum(open|past)?", "restaurantId": "uuid?", "q": { "type": "string?", "desc": "FD- reference, customer name or email" } }, "response": "FoodOrderAdmin", "screens": ["admin/departments-food"] },
    { "id": "getOrderAdmin", "area": "admin", "method": "GET", "path": "/orders/{id}", "summary": "A food order with its history", "auth": "staff", "permission": "food.view", "params": { "id": "uuid" }, "response": "FoodOrderAdmin", "errors": ["NOT_FOUND"], "screens": ["admin/departments-food"] },
    { "id": "moveOrder", "area": "admin", "method": "POST", "path": "/orders/{id}/status", "summary": "Accept, decline, prepare, send, deliver or cancel an order", "desc": "deliver captures the payment; decline and cancel void it.", "auth": "staff", "permission": "food.orders.manage", "params": { "id": "uuid" }, "body": "OrderAction", "response": "FoodOrderAdmin", "errors": ["NOT_FOUND", "ILLEGAL_TRANSITION", "PAYMENT_CAPTURE_FAILED"], "audited": true, "events": ["food.order.status_changed"], "screens": ["admin/departments-food"] },
    { "id": "listReviewsAdmin", "area": "admin", "method": "GET", "path": "/reviews", "summary": "Food reviews, newest first", "auth": "staff", "permission": "food.view", "paging": true, "query": { "restaurantId": "uuid?", "hidden": "bool?", "stars": "int?" }, "response": "ReviewAdmin", "screens": ["admin/departments-food"] },
    { "id": "moderateReview", "area": "admin", "method": "POST", "path": "/reviews/{id}/moderate", "summary": "Hide or show a food review", "auth": "staff", "permission": "food.manage", "params": { "id": "uuid" }, "body": "ReviewModeration", "response": "ReviewAdmin", "errors": ["NOT_FOUND"], "audited": true, "screens": ["admin/departments-food"] }
  ],
  "events": {
    "publishes": [
      { "name": "food.order.status_changed", "when": "A food order is placed or moves (accepted, preparing, on the way, delivered, cancelled, declined, payment failed)", "payload": { "orderId": "uuid", "ref": "string", "customerId": "uuid", "restaurantName": "string", "status": "string", "note": "string?" } }
    ],
    "consumes": [
      { "name": "payments.purchase.authorized", "does": "module food: a pending or challenged payment went through — place the order and empty the basket" },
      { "name": "payments.purchase.failed", "does": "module food: mark the order payment_failed" }
    ]
  },
  "jobs": [
    { "name": "food.geocode-restaurants", "schedule": "on boot", "does": "Backfill: geocode restaurants that have an address but no point (restaurants added before points existed, or while the geocoder could not place them) through customers.geocodeAddress. Staff pins are never touched" },
    { "name": "food.expire-unaccepted", "schedule": "every 5 min", "does": "Decline placed orders not accepted within acceptMinutes (void the payment, tell the customer); cancel payment_pending orders left in a bank challenge for 30 minutes" }
  ],
  "permissions": [
    { "key": "food.view", "audience": "staff", "desc": "See restaurants, menus, food orders and reviews in Admin › Departments › Food delivery" },
    { "key": "food.manage", "audience": "staff", "desc": "Categories, restaurants, menus; hide reviews" },
    { "key": "food.orders.manage", "audience": "staff", "desc": "Accept, decline, move, deliver and cancel food orders" }
  ],
  "settings": [
    { "key": "acceptMinutes", "type": "duration", "default": 15, "unit": "minutes", "min": 5, "max": 120, "desc": "A placed order the restaurant hasn't accepted in this time is declined automatically and the payment released" }
  ],
  "integrations": [],
  "errorCodes": {
    "SLUG_TAKEN": { "status": 409, "meaning": "Another record already uses this slug." },
    "IN_USE": { "status": 409, "meaning": "Items or orders still use it." },
    "OTHER_RESTAURANT": { "status": 409, "meaning": "Your basket has food from another restaurant. details.restaurantName; add again with replace to start a new basket." },
    "OPTIONS_INVALID": { "status": 422, "meaning": "Pick the required options (details.groupId) within their limits." },
    "ITEM_UNAVAILABLE": { "status": 409, "meaning": "An item is no longer available. details.itemIds." },
    "RESTAURANT_UNAVAILABLE": { "status": 409, "meaning": "This restaurant isn't taking orders." },
    "RESTAURANT_CLOSED": { "status": 409, "meaning": "The restaurant is closed now. details.opensLabel." },
    "BELOW_MINIMUM": { "status": 409, "meaning": "Add more to reach the minimum order. details.missing." },
    "BASKET_EMPTY": { "status": 409, "meaning": "Your basket is empty." },
    "PRICE_CHANGED": { "status": 409, "meaning": "Prices changed; details.total is the new total." },
    "ALREADY_REVIEWED": { "status": 409, "meaning": "You already rated this order." },
    "PAYMENT_CAPTURE_FAILED": { "status": 502, "meaning": "The card couldn't be charged; the order stays on the way. Try again or cancel it." }
  },
  "notes": [
    "2026-10-22 (user): Food delivery has its own basket and orders instead of the store's cart and checkout. Restaurants are admin-managed records; staff handle every order on the restaurant's behalf.",
    "Payment: the card is authorized when the order is placed and captured when it is delivered, so declined and cancelled orders are only voided and never need a refund.",
    "Prices: an item's price plus the chosen options' priceDelta, times the quantity. The delivery fee is waived when the subtotal reaches freeDeliveryOver. Order refs are FD- plus five characters from 23456789ABCDEFGHJKLMNPQRSTUVWXYZ.",
    "Open: from the restaurant's hours in its time zone (default the market time zone); paused restaurants show as closed. openLabel: Open until 11 PM, Closes soon · 10:45 PM (within 30 minutes), Closed · opens 5 PM, Closed today.",
    "ETA: from acceptance plus the delivery minutes (deliveryMin–deliveryMax); before acceptance etaLabel shows the delivery time, e.g. Usually 20–30 min.",
    "Ratings: one review per delivered order; it counts for the restaurant and for every item in the order. The reviewer's name is their first name and last initial (customers.getCustomer), else Customer.",
    "Customers are customers-module ids (the store principal's customerId), as payments uses.",
    "Distances (owner decision 2026-10-22): from the customer's geocoded default delivery address (customers.customerLocation) to the restaurant's point, labelled by kernel/lib/geo.ts (0.3 mi, 1.2 mi, 14 mi). Shown on restaurant cards (lists, saved, the item page, the basket) and in the restaurant's meta line. Visitors and customers without a location get distanceLabel null and the card shows the city. Order cards show no distance.",
    "Restaurant points: geocoded from address, city, region and postal code (customers.geocodeAddress) when a restaurant is added or its address changes, unless staff set a pin (point). A failed geocode never fails the save; the food.geocode-restaurants job tries again on the next deploy.",
    "Saved restaurants: PUT and DELETE /saved-restaurants/{slug} are safe to repeat. Reviews screen (store/food-reviews): GET /restaurants/{slug}/ratings for the summary on top, GET /restaurants/{slug}/reviews for the list."
  ]
}
